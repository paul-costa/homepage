{
  "hosting": {
    "site": "projects-costa",
    "public": "dist/homepage/browser",
    "ignore": ["firebase.json", "**/.*"],
    "predeploy": ["npm run build", "node scripts/fetch-infrastructure.mjs"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }],
    "redirects": [
      { "source": "/infrastruktur/homeassistant{,/**}", "destination": "/infrastructure/homeassistant/", "type": 301 },
      { "source": "/infrastruktur{,/**}", "destination": "/infrastructure/", "type": 301 }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
          { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
          { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'" }
        ]
      },
      {
        "source": "/",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "**/!(*.*)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "**/*.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "source": "/infrastructure/**",
        "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
